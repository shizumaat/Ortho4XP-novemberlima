# basemap.at Orthofoto (open data). Host moved from maps{1-4}.wien.gv.at
# to mapsneu.wien.gv.at. Endpoint verified 2026-07-17.
grid_type=webmercator
url_template=https://mapsneu.wien.gv.at/basemap/bmaporthofoto30cm/normal/google3857/{zoom}/{y}/{x}.jpeg
max_threads=16
imagery_dir=grouped
in_GUI=False
